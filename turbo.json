{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "AI_BASE_URL",
    "AI_MODEL",
    "AI_PROVIDER",
    "ANTHROPIC_API_KEY",
    "API_BASE_URL",
    "API_PORT",
    "APP_URL",
    "CI",
    "CLERK_SECRET_KEY",
    "CLOUDINARY_API_KEY",
    "CLOUDINARY_API_SECRET",
    "CLOUDINARY_CLOUD_NAME",
    "CORS_ORIGIN",
    "CRON_SECRET",
    "DATABASE_URL",
    "DEEPSEEK_API_KEY",
    "DIRECT_URL",
    "DOLOYAL_ALLOW_IN_MEMORY_DB",
    "DROPBOX_APP_KEY",
    "ENCRYPTION_KEY",
    "ENCRYPTION_PREVIOUS_KEYS",
    "GEMINI_API_KEY",
    "GITHUB_CLIENT_ID",
    "GOOGLE_ANALYTICS_API_KEY",
    "GOOGLE_BUSINESS_CLIENT_ID",
    "GOOGLE_BUSINESS_CLIENT_SECRET",
    "GOOGLE_CALENDAR_API_KEY",
    "GOOGLE_CALENDAR_CLIENT_ID",
    "GOOGLE_CALENDAR_CLIENT_SECRET",
    "GOOGLE_CALENDAR_REDIRECT_URI",
    "GOOGLE_CALLBACK_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GROQ_API_KEY",
    "HUBSPOT_CLIENT_ID",
    "INVITE_EXPIRY_DAYS",
    "INVITE_RESEND_COOLDOWN_SECONDS",
    "JWT_EXPIRES_IN",
    "JWT_SECRET",
    "LINKEDIN_CLIENT_ID",
    "META_WEBHOOK_VERIFY_TOKEN",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_WEB_URL",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "OPENROUTER_API_KEY",
    "OUTLOOK_CLIENT_ID",
    "PORT",
    "PUBLIC_APP_URL",
    "PUBLIC_SUBDOMAIN_URL_TEMPLATE",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "RESEND_OAUTH_CLIENT_ID",
    "SLACK_CLIENT_ID",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_STORAGE_BUCKET",
    "TURBO_TEAM",
    "TURBO_TOKEN",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_FROM",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "WEB_BASE_URL",
    "WEBSITE_AI_API_KEY",
    "WEBSITE_AI_BASE_URL",
    "WEBSITE_AI_MODEL",
    "WEBSITE_AI_PROVIDER",
    "WHATSAPP_PHONE_ID",
    "WHATSAPP_TOKEN",
    "NEXT_PUBLIC_*",
    "VERCEL_*",
    "TURBO_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "prisma/**", "package.json", "tsconfig.json", "next.config.*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "AI_BASE_URL",
        "AI_MODEL",
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "API_BASE_URL",
        "API_PORT",
        "APP_URL",
        "CI",
        "CLERK_SECRET_KEY",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CLOUDINARY_CLOUD_NAME",
        "CORS_ORIGIN",
        "CRON_SECRET",
        "DATABASE_URL",
        "DEEPSEEK_API_KEY",
        "DIRECT_URL",
        "DOLOYAL_ALLOW_IN_MEMORY_DB",
        "DROPBOX_APP_KEY",
        "ENCRYPTION_KEY",
        "ENCRYPTION_PREVIOUS_KEYS",
        "GEMINI_API_KEY",
        "GITHUB_CLIENT_ID",
        "GOOGLE_ANALYTICS_API_KEY",
        "GOOGLE_BUSINESS_CLIENT_ID",
        "GOOGLE_BUSINESS_CLIENT_SECRET",
        "GOOGLE_CALENDAR_API_KEY",
        "GOOGLE_CALENDAR_CLIENT_ID",
        "GOOGLE_CALENDAR_CLIENT_SECRET",
        "GOOGLE_CALENDAR_REDIRECT_URI",
        "GOOGLE_CALLBACK_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GROQ_API_KEY",
        "HUBSPOT_CLIENT_ID",
        "INVITE_EXPIRY_DAYS",
        "INVITE_RESEND_COOLDOWN_SECONDS",
        "JWT_EXPIRES_IN",
        "JWT_SECRET",
        "LINKEDIN_CLIENT_ID",
        "META_WEBHOOK_VERIFY_TOKEN",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_WEB_URL",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "OPENROUTER_API_KEY",
        "OUTLOOK_CLIENT_ID",
        "PORT",
        "PUBLIC_APP_URL",
        "PUBLIC_SUBDOMAIN_URL_TEMPLATE",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_OAUTH_CLIENT_ID",
        "SLACK_CLIENT_ID",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_STORAGE_BUCKET",
        "TURBO_TEAM",
        "TURBO_TOKEN",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_FROM",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_URL",
        "WEB_BASE_URL",
        "WEBSITE_AI_API_KEY",
        "WEBSITE_AI_BASE_URL",
        "WEBSITE_AI_MODEL",
        "WEBSITE_AI_PROVIDER",
        "WHATSAPP_PHONE_ID",
        "WHATSAPP_TOKEN",
        "NEXT_PUBLIC_*",
        "VERCEL_*",
        "TURBO_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
