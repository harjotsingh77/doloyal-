# ─────────────────────────────────────────────────────────────
# Doloyal — Environment variables
# Copy this file to `.env` at the repo root and fill in values.
# All services work WITHOUT keys via built-in dev/mock fallbacks.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development

# Database (PostgreSQL). Local: docker compose up -d postgres
# DATABASE_URL="postgresql://doloyal:doloyal@localhost:5432/doloyal?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doloyal?schema=public"

# API
API_PORT=4000
API_BASE_URL="http://localhost:4000"
# Comma-separated list of allowed frontend origins (CORS).
# Production: https://app.doloyal.com,https://doloyal.com
CORS_ORIGIN="http://localhost:3000"

# Auth — JWT (used for production auth between app and api)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d
# Clerk (optional in dev: leave blank to use mock dev auth)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
# Mock auth flag (dev only). Set to true to bypass Clerk auth in development.
MOCK_AUTH=true

# Google OAuth (Google login/signup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI — OpenAI (optional in dev: assistant falls back to rule-based templated answers)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payments (stubbed in this build)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Messaging (stubbed in this build)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
RESEND_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# File uploads (stubbed in this build)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URLs
# Production: https://app.doloyal.com (SaaS frontend)
WEB_BASE_URL="http://localhost:3000"
# Production: https://app.doloyal.com
PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Web app (SaaS Next.js app — env vars are build-time; must be
# set in the app.doloyal.com Vercel project)
# ─────────────────────────────────────────────────────────────
# Production: https://api.doloyal.com
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
# Production: https://app.doloyal.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Google OAuth client id for Google sign-in
NEXT_PUBLIC_GOOGLE_CLIENT_ID=