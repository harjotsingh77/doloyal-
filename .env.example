# ─────────────────────────────────────────────────────────────
# Doloyal — Environment variables
#
# LOCAL:    copy this file to `.env` (repo root). The API also reads
#           `.env` / `../../.env` via @nestjs/config, so the root file
#           covers both apps.
# PRODUCTION: set the matching names in each host's dashboard:
#           - Vercel project  → web env vars (NEXT_PUBLIC_*)
#           - Render service  → API env vars
#           - Supabase        → Auth/DB (see README)
#           - Google Cloud    → OAuth client (see README)
#
# The API REQUIRES JWT_SECRET and DATABASE_URL in production, and the
# web app REQUIRES NEXT_PUBLIC_SUPABASE_* + NEXT_PUBLIC_API_BASE_URL,
# otherwise login and every API call fail at runtime.
# ─────────────────────────────────────────────────────────────

# ── Shared ────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL / Supabase) ──────────────────────────
# Local Postgres:   postgresql://postgres:postgres@localhost:5432/doloyal?schema=public
# Supabase Pooler:  postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doloyal?schema=public"
# Port 5432 direct URL, used by Prisma for migrations only
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/doloyal?schema=public"

# ── API ───────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated list of allowed frontend origins (CORS).
# Production MUST include BOTH the apex and www origins:
#   https://doloyal.com,https://www.doloyal.com,http://localhost:3000
# If unset, the API falls back to those same defaults.
CORS_ORIGIN="https://doloyal.com,https://www.doloyal.com,http://localhost:3000"

# ── Auth / JWT ────────────────────────────────────────────────
# REQUIRED in production: strong random string, at least 32 chars.
# The API refuses to boot with the dev default in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d
# Not used by the app anymore (Clerk was replaced by Supabase + JWT);
# kept for backwards compatibility.
CLERK_SECRET_KEY=

# ── Supabase (Auth + Postgres) ────────────────────────────────
# Web (Vercel): public keys, safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# API (Render): server-only, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth ──────────────────────────────────────────────
# Sign-in with Google goes through Supabase Auth. Configure the Google
# provider in the Supabase Dashboard with redirect URL:
#   Local:      http://localhost:3000/auth/callback
#   Production: https://www.doloyal.com/auth/callback
# GOOGLE_CLIENT_ID/SECRET below are used by the API only, for Google
# integration OAuth (Calendar, Gmail, Drive) — NOT for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Google Calendar integration OAuth — dedicated OAuth client (separate from the
# sign-in client above). Authorize/consent redirects to:
#   Local:      http://localhost:3000/app/integrations/callback
#   Production: https://www.doloyal.com/app/integrations/callback
# Set GOOGLE_CALENDAR_REDIRECT_URI to override the default (derived from NODE_ENV).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# ── AI (Doloyal AI + Workflow AI) ─────────────────────────────
# Choose a provider: openai | openrouter | groq | deepseek | gemini | anthropic
# openrouter is recommended — a single key gives access to many models.
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override for any provider's base URL.
AI_BASE_URL=

# ── Web app (Next.js — NEXT_PUBLIC_* are baked at build time) ─
# Set in the Vercel project for https://www.doloyal.com.
# NEXT_PUBLIC_API_BASE_URL MUST point at the DEPLOYED API URL in production
# (e.g. https://<your-api>.onrender.com). If it is unset or left as
# http://localhost:4000 when `next build` runs, every production API call
# silently targets localhost and fails with CORS/"Failed to fetch".
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Payments (stubbed in this build) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Messaging (stubbed in this build) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Resend (user-level OAuth, per-business sending) ───────────
# Each business connects its OWN Resend account via OAuth (PKCE, public
# client). Doloyal never holds a Resend API key. Register Doloyal as a
# Resend OAuth client once with Dynamic Client Registration (DCR):
#
#   Local:      node scripts/register-resend-oauth.mjs --app-url http://localhost:3000
#   Production: node scripts/register-resend-oauth.mjs --app-url https://www.doloyal.com
#
# Paste the returned client_id below. There is NO client_secret. The
# registered redirect URI is <app-url>/app/integrations/callback and must
# match the OAuth callback page exactly.
#
# RESEND_FROM is only a fallback sender when the business has not connected
# Resend and has no verified sending domain of its own (used by legacy
# staff-invite emails). Connected businesses send from their own verified
# Resend domain.
RESEND_OAUTH_CLIENT_ID=
RESEND_FROM=

# ── File uploads (stubbed in this build) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
