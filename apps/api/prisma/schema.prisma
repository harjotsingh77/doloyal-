  events        ReferralEvent[]
  sources       ReferralSource[]
  registrations ReferralRegistration[]

  @@index([tenantId, code])
  @@index([tenantId, customerId])
  @@index([tenantId, customSlug])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
}

model ReferralVisit {
  id                 String   @id @default(uuid())
  tenantId           String
  linkId             String
  campaignId         String?
  referrerCustomerId String?
  sessionId          String
  ip                 String?
  fingerprint        String?
  browser            String?
  os                 String?
  deviceType         String?
  country            String?
  state              String?
  city               String?
  timezone           String?
  language           String?
  userAgent          String?
  referrerUrl        String?
