  link        ReferralLink?     @relation(fields: [linkId], references: [id], onDelete: SetNull)
  referrer    Customer?         @relation("RegistrationReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  newCustomer Customer          @relation("RegistrationFriend", fields: [newCustomerId], references: [id], onDelete: Cascade)

  @@index([tenantId, registeredAt])
  @@index([linkId])
  @@index([newCustomerId])
}

model ReferralConversion {
  id                String                  @id @default(uuid())
  tenantId          String
  campaignId        String?
  linkId            String?
  referrerId        String?
  friendId          String?
  friendEmail       String?
  friendPhone       String?
  status            ReferralLifecycleStatus @default(PENDING)
  source            String?
  conversionType    String?
  bookingValue      Float                   @default(0)
  orderValue        Float                   @default(0)
  appointmentId     String?
  invoiceId         String?
  rewardType        String?
  rewardValue       Float                   @default(0)
  friendRewardType  String?
  friendRewardValue Float                   @default(0)
  rewardStatus      String                  @default("PENDING")
  rejectReason      String?
  fraudFlags        Json?
  suspicious        Boolean                 @default(false)
  visitedAt         DateTime?
  signedUpAt        DateTime?
  bookedAt          DateTime?
  convertedAt       DateTime?
  rewardedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign ReferralCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  link     ReferralLink?          @relation(fields: [linkId], references: [id], onDelete: SetNull)
  referrer Customer?              @relation("ConversionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  friend   Customer?              @relation("ConversionFriend", fields: [friendId], references: [id], onDelete: SetNull)
  rewards  ReferralRewardRecord[]
  events   ReferralEvent[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([referrerId])
  @@index([friendId])
  @@index([tenantId, rewardStatus])
}

model ReferralRewardRecord {
  id                  String    @id @default(uuid())
  tenantId            String
  conversionId        String
  customerId          String
  role                String // REFERRER | FRIEND
  rewardType          String
