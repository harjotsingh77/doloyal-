  channel   String   @default("EMAIL")
  subject   String?
  body      String // supports {{variables}}
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, channel])
}

model BlockedDate {
  id        String    @id @default(uuid())
  tenantId  String
  staffId   String?
  date      DateTime // date only (start of day)
  reason    String?
  isFullDay Boolean   @default(true)
  startTime DateTime?
  endTime   DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
}

model CalendarEvent {
  id            String   @id @default(uuid())
  tenantId      String
  appointmentId String?
  externalId    String? // Google/Outlook event ID
  provider      String   @default("GOOGLE") // GOOGLE, OUTLOOK, APPLE
  eventType     String   @default("APPOINTMENT")
  title         String
  startTime     DateTime
  endTime       DateTime
  description   String?
  location      String?
  status        String   @default("ACTIVE") // ACTIVE, CANCELLED
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, provider])
  @@index([appointmentId])
}

model WidgetSettings {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  primaryColor String   @default("#2563EB")
  fontFamily   String   @default("Inter")
  borderRadius String   @default("8px")
  showStaff    Boolean  @default(true)
  showServices Boolean  @default(true)
  showDuration Boolean  @default(true)
  showPrice    Boolean  @default(true)
  customCss    String?
  greeting     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AvailabilityConfig {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  monday              Json?
  tuesday             Json?
  wednesday           Json?
  thursday            Json?
  friday              Json?
  saturday            Json?
  sunday              Json?
  slotIntervalMinutes Int      @default(30)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Website Builder
// ─────────────────────────────────────────────────────────────────────────────

enum WebsiteStatus {
  DRAFT
  GENERATING
  PUBLISHED
  ARCHIVED
}

enum WebsitePageStatus {
  DRAFT
  PUBLISHED
}

enum WebsiteComponentType {
  HERO
  FEATURES
  SERVICES
  GALLERY
  TEAM
  PRICING
  TESTIMONIALS
  FAQ
  ABOUT
  CONTACT
  FOOTER
  HEADER
  CTA
  BLOG
  NEWSLETTER
  STATS
  VIDEO
  MAP
  TIMELINE
  CUSTOM
}

/// A business website generated and managed through the Website Builder.
model Website {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  slug         String        @unique
  description  String?
  status       WebsiteStatus @default(DRAFT)
  industry     String?
  theme        Json?
  brandData    Json?
  publishedAt  DateTime?
  draftVersion Int           @default(0)
  liveVersion  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  pages       WebsitePage[]
  assets      WebsiteAsset[]
  domains     WebsiteDomain[]
  deployments WebsiteDeployment[]
  generations AIWebsiteGeneration[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([slug])
}

model WebsitePage {
  id        String            @id @default(cuid())
  websiteId String
  title     String
  slug      String
  sortOrder Int               @default(0)
  status    WebsitePageStatus @default(DRAFT)
  isHome    Boolean           @default(false)
  seo       Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  sections WebsiteSection[]

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations
// ─────────────────────────────────────────────────────────────────────────────

enum IntegrationType {
  GOOGLE_CALENDAR
  STRIPE
  RAZORPAY
  RESEND
  WHATSAPP
  SMS
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
  /// The stored OAuth grant is no longer usable (e.g. refresh token was
  /// revoked). The user must reconnect the provider.
  REAUTH_REQUIRED
}

/// A connected third-party service integration for a tenant.
model Integration {
  id           String            @id @default(uuid())
  tenantId     String
  userId       String?
  type         IntegrationType
  status       IntegrationStatus @default(DISCONNECTED)
  label        String? // user-facing name for the connection
  metadata     Json? // store non-sensitive config (e.g. connected email, account name)
  errorLog     String?
  lastSyncedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  tokens        IntegrationToken[]
  syncLogs      SyncLog[]
  webhookEvents WebhookEvent[]
  emailLogs     EmailLog[]
  resendDomains ResendDomain[]

  @@unique([tenantId, type])
  @@index([tenantId])
}

/// Encrypted OAuth tokens / API keys for an integration.
model IntegrationToken {
  id            String    @id @default(uuid())
  integrationId String
  accessToken   String? // encrypted
  refreshToken  String? // encrypted
  tokenType     String    @default("Bearer")
  scope         String?
  expiresAt     DateTime?
  apiKey        String? // encrypted (for API-key-based integrations)
  apiSecret     String? // encrypted (for API-key-based integrations)
  webhookSecret String? // encrypted
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}

/// Outbound email record for a tenant, sent through a connected provider
/// (Resend). Kept immutable — historical send history survives disconnects.
model EmailLog {
  id                 String    @id @default(uuid())
  tenantId           String
  integrationId      String?
  customerId         String?
  provider           String    @default("RESEND")
  providerMessageId  String?
  fromEmail          String?
  toEmail            String
  subject            String?
  status             String    @default("SENT") // SENT, FAILED
  error              String?
  workflowId         String?
  campaignId         String?
  appointmentId      String?
  notificationType   String? // e.g. BOOKING_CONFIRMATION, REMINDER_24H
  metadata           Json?
  createdAt          DateTime  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  workflow     Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([customerId])
}

/// A sending domain registered on the business's Resend account.
/// Created/managed through the connected business's Resend OAuth connection.
model ResendDomain {
  id              String    @id @default(uuid())
  tenantId        String
  integrationId   String?
  domain          String
  status          String    @default("PENDING") // PENDING, VERIFIED, FAILED
  resendDomainId  String?
  dnsRecords      Json?
  isDefault       Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, domain])
  @@index([tenantId])
}

model WebsiteSection {
  id          String               @id @default(cuid())
  pageId      String
  component   WebsiteComponentType
  sortOrder   Int                  @default(0)
  content     Json
  styles      Json?
  isPublished Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  page WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model WebsiteAsset {
  id        String   @id @default(cuid())
  websiteId String
  url       String
  type      String
  fileKey   String?
  alt       String?
  width     Int?
  height    Int?
  sizeBytes Int?
  isAi      Boolean  @default(false)
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model WebsiteDomain {
  id            String    @id @default(cuid())
  websiteId     String
  domain        String    @unique
  verified      Boolean   @default(false)
  sslStatus     String    @default("PENDING")
  dnsRecords    Json?
  verifiedAt    DateTime?
  provisionedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([domain])
}

model WebsiteDeployment {
  id          String   @id @default(cuid())
  websiteId   String
  version     Int
  status      String   @default("BUILDING")
  errorLog    String?
  buildTimeMs Int?
  previewUrl  String?
  liveUrl     String?
  lighthouse  Json?
  createdAt   DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model AIWebsiteGeneration {
  id           String    @id @default(cuid())
  websiteId    String
  prompt       String
  mergedData   Json?
  model        String    @default("gpt-4o")
  status       String    @default("PENDING")
  result       Json?
  errorMessage String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

// ─── Website Connections (external site sync backend) ─────────────────────

enum WebsiteConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

enum WebsiteFramework {
  HTML
  PHP
  REACT
  NEXTJS
  VUE
  LARAVEL
  WORDPRESS
  SHOPIFY
  ANGULAR
  NODE
  EXPRESS
  CUSTOM
}

enum ConnectionLogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

/// A third-party or builder website connected to a Doloyal business.
model ConnectedWebsite {
  id              String                  @id @default(uuid())
  tenantId        String
  /// Public business identifier used by the SDK (stable per tenant).
  businessId      String
  name            String
  websiteUrl      String
  framework       WebsiteFramework        @default(HTML)
  status          WebsiteConnectionStatus @default(PENDING)
  connectionToken String                  @unique
  lastSyncAt      DateTime?
  /// Aggregate counters: customers, appointments, memberships, rewards, forms
  stats           Json?
  settings        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys          WebsiteApiKey[]
  webhooks         WebsiteWebhook[]
  logs             ConnectionLog[]
  sdkInstallations SdkInstallation[]

  @@index([tenantId])
  @@index([businessId])
  @@index([status])
}

/// API credentials for a connected website. Secret values are stored hashed.
model WebsiteApiKey {
  id                  String    @id @default(uuid())
  tenantId            String
  connectedWebsiteId  String
  businessId          String
  publicKey           String    @unique
  secretKeyHash       String
  secretKeyPrefix     String
  webhookSecretHash   String
  webhookSecretPrefix String
  label               String?
  isActive            Boolean   @default(true)
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedWebsite ConnectedWebsite @relation(fields: [connectedWebsiteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectedWebsiteId])
  @@index([businessId])
  @@index([publicKey])
}

/// Outbound webhook endpoints for website connection events.
model WebsiteWebhook {
  id                 String    @id @default(uuid())
  tenantId           String
  connectedWebsiteId String
  businessId         String
  url                String
  secretHash         String
  secretPrefix       String
  events             String[]
  isActive           Boolean   @default(true)
  failureCount       Int       @default(0)
  lastDeliveryAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedWebsite ConnectedWebsite @relation(fields: [connectedWebsiteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectedWebsiteId])
  @@index([businessId])
}

/// Audit / activity log for website connection events.
model ConnectionLog {
  id                 String             @id @default(uuid())
  tenantId           String
  connectedWebsiteId String?
  businessId         String
  level              ConnectionLogLevel @default(INFO)
  event              String
  message            String
  metadata           Json?
  createdAt          DateTime           @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedWebsite ConnectedWebsite? @relation(fields: [connectedWebsiteId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([connectedWebsiteId, createdAt])
  @@index([businessId])
}

/// Tracks SDK installs detected on connected domains.
model SdkInstallation {
  id                 String           @id @default(uuid())
  tenantId           String
  connectedWebsiteId String?
  businessId         String
  framework          WebsiteFramework @default(HTML)
  version            String?
  domain             String
  status             String           @default("ACTIVE")
  lastSeenAt         DateTime         @default(now())
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedWebsite ConnectedWebsite? @relation(fields: [connectedWebsiteId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([connectedWebsiteId])
  @@index([businessId])
  @@index([domain])
}

// ─── Doloyal AI Assistant ────────────────────────────────────────────────────

model AiConversation {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  title     String    @default("New chat")
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages    AiMessage[]
  attachments AiAttachment[]
  feedback    AiFeedback[]

  @@index([tenantId, userId, updatedAt])
  @@index([tenantId, pinned])
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  tenantId       String
  role           String // user | assistant | system
  content        String
  model          String?
  provider       String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  toolCalls      Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  AiAttachment[]
  feedback     AiFeedback[]

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

model AiAttachment {
  id             String   @id @default(uuid())
  conversationId String?
  messageId      String?
  tenantId       String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String?
  textExtract    String?
  previewUrl     String?
  createdAt      DateTime @default(now())

  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AiMessage?      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@index([tenantId])
}

model AiFeedback {
  id             String   @id @default(uuid())
  conversationId String?
  messageId      String
  tenantId       String
  userId         String
  rating         String // like | dislike
  comment        String?
  createdAt      DateTime @default(now())

  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AiMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([tenantId])
}

model AiUsage {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  conversationId String?
  provider       String
  model          String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  latencyMs      Int      @default(0)
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Website Services — customer requests + admin chat
// ─────────────────────────────────────────────────────────────────────────────

enum WebsiteProjectStatus {
  REQUESTED
  REVIEWING
  IN_DISCUSSION
  IN_PROGRESS
  DESIGN_REVIEW
  DEVELOPMENT
  READY_FOR_REVIEW
  PUBLISHED
  COMPLETED
}

enum WebsiteConversationStatus {
  OPEN
  CLOSED
}

/// A professional website request submitted by a Doloyal customer. The Doloyal
/// team (admins) review it and build the site, while the customer discusses and
/// tracks the project through the built-in chat.
model WebsiteProject {
  id             String               @id @default(cuid())
  tenantId       String
  customerUserId String
  name           String
  websiteType    String
  goal           String?
  status         WebsiteProjectStatus @default(REQUESTED)
  liveUrl        String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerUser  User                          @relation("CustomerWebsiteProjects", fields: [customerUserId], references: [id], onDelete: Cascade)
  requirements  WebsiteProjectRequirement?
  files         WebsiteProjectFile[]
  conversation  WebsiteConversation?
  statusHistory WebsiteProjectStatusHistory[]

  @@index([tenantId, status])
  @@index([customerUserId])
  @@index([status, updatedAt])
}

/// Structured answers captured by the Website Services request form.
model WebsiteProjectRequirement {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  businessName           String
  businessType           String
  businessLocation       String?
  businessPhone          String?
  businessEmail          String?
  existingWebsiteUrl     String?
  /// One or more website types (Business, Booking, Landing Page, E-commerce…)
  websiteTypes           String[] @default([])
  /// Preferred design styles (Minimal, Modern, Premium, Bold…)
  designStyle            String[] @default([])
  /// REFERENCE (customer provided a reference) | SUGGEST (Doloyal decides)
  designPreference       String
  referenceUrl           String?
  hasLogo                Boolean  @default(false)
  logoUrl                String?
  pageCount              String
  requiredFeatures       String[] @default([])
  additionalRequirements String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Files uploaded to a website project (reference images, logo, brand assets,
/// chat attachments). URLs are stored as data-URLs matching the tenant upload
/// flow so they stay fully persistent without external storage credentials.
model WebsiteProjectFile {
  id               String   @id @default(cuid())
  projectId        String
  uploadedByUserId String
  uploadedByRole   String   @default("CUSTOMER") // CUSTOMER | ADMIN
  /// REFERENCE | LOGO | BRAND_ASSET | CHAT_ATTACHMENT
  category         String
  fileName         String
  mimeType         String?
  sizeBytes        Int?
  url              String
  createdAt        DateTime @default(now())

  project WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// One conversation per website project, linking the customer with the
/// Doloyal team. `assignedAdminId` is set when an admin picks up the request.
model WebsiteConversation {
  id                String                    @id @default(cuid())
  projectId         String                    @unique
  tenantId          String
  assignedAdminId   String?
  assignedAdminName String?
  status            WebsiteConversationStatus @default(OPEN)
  lastMessageAt     DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  project  WebsiteProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin    User?                     @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages WebsiteMessage[]
  notes    WebsiteConversationNote[]

  @@index([tenantId, status])
}

/// Chat messages exchanged between the customer and the Doloyal team.
model WebsiteMessage {
  id                 String    @id @default(cuid())
  conversationId     String
  tenantId           String
  senderId           String
  /// CUSTOMER | ADMIN | SYSTEM
  senderRole         String
  message            String
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  /// Inline-rendered confirmation that a URL was shared.
  isLink             Boolean   @default(false)
  readAt             DateTime?
  createdAt          DateTime  @default(now())

  conversation WebsiteConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

/// Immutable record of every project status transition.
model WebsiteProjectStatusHistory {
  id            String   @id @default(cuid())
  projectId     String
  oldStatus     String?
  newStatus     String
  changedById   String?
  changedByName String?
  note          String?
  createdAt     DateTime @default(now())

  project   WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User?          @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

/// Private notes admins attach to a project's conversation (internal only).
model WebsiteConversationNote {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  authorName     String?
  note           String
  createdAt      DateTime @default(now())

  conversation WebsiteConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── Help & Support ─────────────────────────────────────────────────────────

/// A support ticket created by a customer. Every ticket is also the chat
/// conversation — messages are attached directly to the ticket.
model SupportTicket {
  id              String          @id @default(cuid())
  ticketNumber    String          @unique
  tenantId        String
  userId          String
  subject         String
  category        String
  priority        SupportPriority @default(NORMAL)
  description     String
  status          SupportStatus   @default(OPEN)
  assignedAgentId String?
  /// The Ask Doloyal AI conversation this ticket was escalated from (if any).
  conversationId String?
  /// The dashboard page the user was on when the ticket was created.
  currentPage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  closedAt        DateTime?

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                   @relation("SupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedAgent User?                  @relation("SupportAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  conversation  SupportConversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]
  attachments   SupportAttachment[]
  internalNotes SupportInternalNote[]
  statusHistory SupportStatusHistory[]
  events        SupportTicketEvent[]

  @@index([tenantId, status])
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([assignedAgentId])
  @@index([conversationId])
}

/// A persisted Ask Doloyal support conversation (AI + optional human handoff
/// through the linked ticket). Kept separate from the business AI assistant.
model SupportConversation {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  title     String   @default("New chat")
  /// AI | HUMAN — whether a human agent has taken over this thread.
  mode      String   @default("AI")
  status    String   @default("ACTIVE") // ACTIVE | ARCHIVED
  currentPage String?
  /// Safe snapshot of account context (plan, integrations, feature flags).
  context   Json?
  /// Unread AI/agent replies waiting for the user (drives the Ask Doloyal badge).
  unreadCount Int   @default(0)
  /// When the user last opened / read the conversation.
  lastReadAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User                   @relation("SupportConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages SupportConversationMessage[]
  tickets  SupportTicket[]

  @@index([tenantId, userId, updatedAt])
  @@index([userId, updatedAt])
}

/// Messages inside an Ask Doloyal support conversation.
model SupportConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  tenantId       String
  /// USER | AI | SYSTEM
  senderType     String
  content        String
  /// Optional attachments (safe data-URLs or references) attached to a message.
  attachments    Json?
  /// Extra signal: suggestedTicketCategory / priority / sources / escalate flag.
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

/// Immutable event log for a support ticket lifecycle.
model SupportTicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  tenantId  String
  actorId   String?
  actorName String?
  eventType String // TICKET_CREATED | ADMIN_REPLIED | CUSTOMER_REPLIED | STATUS_CHANGED | ASSIGNED | NOTE_ADDED | RESOLVED | REOPENED
  metadata  Json?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([tenantId, createdAt])
}

/// Chat messages exchanged between the customer and the Doloyal support team.
model SupportMessage {
  id                 String    @id @default(cuid())
  ticketId           String
  tenantId           String
  senderId           String
  /// CUSTOMER | ADMIN | SYSTEM
  senderRole         String
  message            String
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  isLink             Boolean   @default(false)
  readAt             DateTime?
  createdAt          DateTime  @default(now())

  ticket            SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  SupportAttachment SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([tenantId, createdAt])
}

/// Files uploaded against a ticket (chat attachments). URLs are data-URLs so
/// they persist without external storage credentials.
model SupportAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  messageId  String?
  uploadedBy String
  fileUrl    String
  fileName   String
  fileType   String?
  fileSize   Int?
  createdAt  DateTime @default(now())

  ticket  SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message SupportMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

/// Private notes admins attach to a ticket. NEVER exposed to customers.
model SupportInternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  adminId   String?
  adminName String?
  note      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  User?         @relation("SupportNoteAuthor", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/// Immutable record of every ticket status transition.
model SupportStatusHistory {
  id            String   @id @default(cuid())
  ticketId      String
  oldStatus     String?
  newStatus     String
  changedById   String?
  changedByName String?
  note          String?
  createdAt     DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User?         @relation("SupportStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/// Help center article used by the Help & Support search + FAQ. Content is
/// seeded and curated by the Doloyal team.
model SupportArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  content     String
  category    String
  keywords    String[] @default([])
  faq         Boolean  @default(false)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([published, faq])
}

// ─── Admin Control Center ───────────────────────────────────────────────────

/// Immutable platform-level audit trail for sensitive admin actions.
/// Admins cannot modify these rows through any API.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorName  String?
  /// Human-readable action, e.g. "business.suspended", "refund.issued".
  action     String
  category   String
  targetType String?
  targetId   String?
  targetName String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/// Platform service logs (API errors, webhook/job/AI/payment failures, etc.).
model SystemLog {
  id          String            @id @default(cuid())
  service     String
  severity    SystemLogSeverity @default(INFO)
  message     String
  error       String?
  stack       String?
  requestId   String?
  environment String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([service, createdAt])
  @@index([severity, createdAt])
  @@index([createdAt])
}

/// Security-relevant admin events (logins, role changes, suspicious activity).
model AdminSecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  severity  String   @default("INFO")
  message   String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

/// Notifications delivered to the admin notification center.
/// recipientId null = broadcast to every admin.
model AdminNotification {
  id          String    @id @default(cuid())
  type        String
  title       String
  message     String?
  severity    String    @default("INFO")
  link        String?
  targetId    String?
  recipientId String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User? @relation("AdminNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([createdAt])
  @@index([type, createdAt])
}

/// Platform announcements surfaced to customers through the app.
model Announcement {
  id               String             @id @default(cuid())
  title            String
  message          String
  type             AnnouncementType   @default(FEATURE)
  audience         AnnouncementAudience @default(ALL)
  /// Tenant ids when audience == SELECTED_BUSINESSES
  selectedTenantIds String[]          @default([])
  publishDate      DateTime?
  expiryDate       DateTime?
  published        Boolean            @default(false)
  createdById      String?
  createdByName    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  createdBy User? @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([published, publishDate])
  @@index([audience, published])
}

/// Customer product feedback + feature requests surfaced to the Doloyal team.
model FeedbackRequest {
  id          String             @id @default(cuid())
  userId      String?
  tenantId    String?
  type        FeedbackRequestType @default(FEATURE_REQUEST)
  title       String
  description String?
  category    String?
  status      FeedbackStatus     @default(NEW)
  votes       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  votesByUser FeedbackVote[]

  @@index([type, status])
  @@index([tenantId, createdAt])
}

/// One row per user vote on a FeedbackRequest (unique per user + request).
model FeedbackVote {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  createdAt  DateTime @default(now())

  feedback FeedbackRequest @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
}

/// Key/value platform configuration managed from the admin Settings module.
/// Secrets are never stored here — the UI only exposes safe, non-secret values.
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  type        String   @default("string")
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("PlatformSettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Custom contract details for Enterprise subscriptions.
model EnterpriseContract {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  contractPrice  Float
  billingCycle   String   @default("MONTHLY") // MONTHLY | QUARTERLY | HALF_YEARLY | YEARLY | ONE_TIME
  startDate      DateTime
  renewalDate    DateTime?
  customerLimit  Int      @default(-1)
  branchLimit    Int      @default(-1)
  seats          Int      @default(5)
  customFeatures Json?
  sla            String?
  notes          String?
  status         String   @default("ACTIVE") // ACTIVE | EXPIRED | RENEGOTIATING
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Overridable plan entitlement configuration. When a row exists for a plan,
/// the admin panel and feature-gating read entitlements from here instead of
/// the static shared PLANS definitions.
model PlanConfig {
  id          String   @id @default(cuid())
  plan        String   @unique // free | starter | growth | professional | enterprise
  config      Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("PlanConfigEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Workflows — automation engine
// Every workflow belongs to a single tenant (business). Tenant isolation is
// enforced at the DB level by the Prisma tenant middleware (see TENANT_MODELS).
// ─────────────────────────────────────────────────────────────────────────────

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
  ARCHIVED
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum WorkflowRunStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  RETRYING
}

model Workflow {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  description String?
  /// Structured trigger definition { type, config, params }.
  trigger     Json
  /// Latest snapshot of the full workflow definition (nodes + edges).
  definition  Json
  status      WorkflowStatus @default(DRAFT)
  version     Int            @default(1)
  createdBy   String?
  activatedAt DateTime?
  pausedAt    DateTime?
  lastRunAt   DateTime?
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nodes     WorkflowNode[]
  edges     WorkflowEdge[]
  versions  WorkflowVersion[]
  runs      WorkflowRun[]
  auditLogs WorkflowAuditLog[]
  emailLogs EmailLog[]

  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
}

model WorkflowNode {
  id         String   @id @default(uuid())
  workflowId String
  nodeKey    String // e.g. trigger, step_1, branch_1, end
  type       String // trigger | action | condition | delay | branch | end
  label      String
  config     Json
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, nodeKey])
  @@index([workflowId])
}

model WorkflowEdge {
  id         String   @id @default(uuid())
  workflowId String
  sourceNode String
  targetNode String
  /// Outcome label: null (default), "true", "false", or a branch label.
  outcome    String?
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

/// Immutable version history. Editing an ACTIVE workflow creates a new
/// DRAFT version; the running version is never silently mutated.
model WorkflowVersion {
  id          String   @id @default(uuid())
  workflowId  String
  version     Int
  status      String   @default("DRAFT") // DRAFT | ACTIVE | SUPERSEDED
  definition  Json
  createdBy   String?
  activatedAt DateTime?
  createdAt   DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId])
}

model WorkflowRun {
  id             String              @id @default(uuid())
  tenantId       String
  workflowId     String
  version        Int                 @default(1)
  customerId     String?
  status         WorkflowRunStatus   @default(QUEUED)
  trigger        String
  triggerData    Json?
  idempotencyKey String?             @unique
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps    WorkflowRunStep[]

  @@index([tenantId, workflowId, createdAt])
  @@index([workflowId, status])
}

model WorkflowRunStep {
  id          String                 @id @default(uuid())
  runId       String
  nodeKey     String
  type        String
  status      WorkflowRunStepStatus  @default(PENDING)
  attempt     Int                    @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  output      Json?
  createdAt   DateTime               @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/// Seedable workflow templates used as structured starting points.
model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String // RETENTION | BOOKING | LOYALTY | MEMBERSHIP
  description String?
  definition  Json
  createdAt   DateTime @default(now())
}

/// Audit trail for workflow lifecycle events (create/edit/activate/pause…).
model WorkflowAuditLog {
  id         String    @id @default(uuid())
  workflowId String
  actorId    String?
  actorName  String?
  action     String
  version    Int?
  details    Json?
  createdAt  DateTime  @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
}
