  CTA
  BLOG
  NEWSLETTER
  STATS
  VIDEO
  MAP
  TIMELINE
  CUSTOM
}

/// A business website generated and managed through the Website Builder.
model Website {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  slug        String         @unique
  description String?
  status      WebsiteStatus  @default(DRAFT)
  industry    String?
  theme       Json?
  brandData   Json?
  publishedAt DateTime?
  draftVersion Int           @default(0)
  liveVersion  Int           @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  pages        WebsitePage[]
  assets       WebsiteAsset[]
  domains      WebsiteDomain[]
  deployments  WebsiteDeployment[]
  generations  AIWebsiteGeneration[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([slug])
}

model WebsitePage {
  id        String            @id @default(cuid())
  websiteId String
  title     String
  slug      String
  sortOrder Int               @default(0)
  status    WebsitePageStatus @default(DRAFT)
  isHome    Boolean           @default(false)
  seo       Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  sections WebsiteSection[]

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@index([websiteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations
// ─────────────────────────────────────────────────────────────────────────────

enum IntegrationType {
  GOOGLE_CALENDAR
  STRIPE
  RAZORPAY
  RESEND
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

/// A connected third-party service integration for a tenant.
model Integration {
  id         String            @id @default(uuid())
  tenantId   String
  userId     String?
  type       IntegrationType
  status     IntegrationStatus @default(DISCONNECTED)
  label      String?           // user-facing name for the connection
  metadata   Json?             // store non-sensitive config (e.g. connected email, account name)
  errorLog   String?
  lastSyncedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  tokens      IntegrationToken[]
  syncLogs    SyncLog[]
  webhookEvents WebhookEvent[]

  @@unique([tenantId, type])
  @@index([tenantId])
}

/// Encrypted OAuth tokens / API keys for an integration.
model IntegrationToken {
  id             String   @id @default(uuid())
  integrationId  String
  accessToken    String?  // encrypted
  refreshToken   String?  // encrypted
  tokenType      String   @default("Bearer")
  scope          String?
  expiresAt      DateTime?
  apiKey         String?  // encrypted (for API-key-based integrations)
  apiSecret      String?  // encrypted (for API-key-based integrations)
  webhookSecret  String?  // encrypted
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}

model WebsiteSection {
  id          String              @id @default(cuid())
  pageId      String
  component   WebsiteComponentType
  sortOrder   Int                 @default(0)
  content     Json
  styles      Json?
  isPublished Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  page WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@index([pageId])
}

model WebsiteAsset {
  id         String   @id @default(cuid())
  websiteId  String
  url        String
  type       String
  fileKey    String?
  alt        String?
  width      Int?
  height     Int?
  sizeBytes  Int?
  isAi       Boolean  @default(false)
  createdAt  DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@index([websiteId])
}

model WebsiteDomain {
  id              String   @id @default(cuid())
  websiteId       String
  domain          String   @unique
  verified        Boolean  @default(false)
  sslStatus       String   @default("PENDING")
  dnsRecords      Json?
  verifiedAt      DateTime?
  provisionedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@index([websiteId])
  @@index([domain])
}

model WebsiteDeployment {
  id          String   @id @default(cuid())
  websiteId   String
  version     Int
  status      String   @default("BUILDING")
  errorLog    String?
  buildTimeMs Int?
  previewUrl  String?
  liveUrl     String?
  lighthouse  Json?
  createdAt   DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@index([websiteId])
}

model AIWebsiteGeneration {
  id           String   @id @default(cuid())
  websiteId    String
  prompt       String
  mergedData   Json?
  model        String   @default("gpt-4o")
  status       String   @default("PENDING")
  result       Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@index([websiteId])
}

// ─── Website Connections (external site sync backend) ─────────────────────

enum WebsiteConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

enum WebsiteFramework {
  HTML
  PHP
  REACT
  NEXTJS
  VUE
  LARAVEL
  WORDPRESS
  SHOPIFY
  ANGULAR
  NODE
  EXPRESS
  CUSTOM
}

enum ConnectionLogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

/// A third-party or builder website connected to a Doloyal business.
model ConnectedWebsite {
  id              String                  @id @default(uuid())
  tenantId        String
  /// Public business identifier used by the SDK (stable per tenant).
  businessId      String
  name            String
  websiteUrl      String
  framework       WebsiteFramework        @default(HTML)
  status          WebsiteConnectionStatus @default(PENDING)
  connectionToken String                  @unique
  lastSyncAt      DateTime?
  /// Aggregate counters: customers, appointments, memberships, rewards, forms
  stats           Json?
  settings        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys          WebsiteApiKey[]
  webhooks         WebsiteWebhook[]
  logs             ConnectionLog[]
  sdkInstallations SdkInstallation[]

  @@index([tenantId])
  @@index([businessId])
  @@index([status])
}

/// API credentials for a connected website. Secret values are stored hashed.
model WebsiteApiKey {
  id                 String    @id @default(uuid())
  tenantId           String
  connectedWebsiteId String
  businessId         String
  publicKey          String    @unique
  secretKeyHash      String
  secretKeyPrefix    String
  webhookSecretHash  String
  webhookSecretPrefix String
  label              String?
  isActive           Boolean   @default(true)
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedWebsite ConnectedWebsite @relation(fields: [connectedWebsiteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectedWebsiteId])
  @@index([businessId])
  @@index([publicKey])
}

/// Outbound webhook endpoints for website connection events.
model WebsiteWebhook {
  id                 String   @id @default(uuid())
  tenantId           String
  connectedWebsiteId String
  businessId         String
  url                String
  secretHash         String
  secretPrefix       String
  events             String[]
  isActive           Boolean  @default(true)
  failureCount       Int      @default(0)
  lastDeliveryAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedWebsite ConnectedWebsite @relation(fields: [connectedWebsiteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectedWebsiteId])
  @@index([businessId])
}

/// Audit / activity log for website connection events.
model ConnectionLog {
  id                 String             @id @default(uuid())
  tenantId           String
  connectedWebsiteId String?
  businessId         String
  level              ConnectionLogLevel @default(INFO)
  event              String
  message            String
  metadata           Json?
  createdAt          DateTime           @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedWebsite ConnectedWebsite? @relation(fields: [connectedWebsiteId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([connectedWebsiteId, createdAt])
  @@index([businessId])
}

/// Tracks SDK installs detected on connected domains.
model SdkInstallation {
  id                 String           @id @default(uuid())
  tenantId           String
  connectedWebsiteId String?
  businessId         String
  framework          WebsiteFramework @default(HTML)
  version            String?
  domain             String
  status             String           @default("ACTIVE")
  lastSeenAt         DateTime         @default(now())
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedWebsite ConnectedWebsite? @relation(fields: [connectedWebsiteId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([connectedWebsiteId])
  @@index([businessId])
  @@index([domain])
}

// ─── Doloyal AI Assistant ────────────────────────────────────────────────────

model AiConversation {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  title     String    @default("New chat")
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages    AiMessage[]
  attachments AiAttachment[]
  feedback    AiFeedback[]

  @@index([tenantId, userId, updatedAt])
  @@index([tenantId, pinned])
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  tenantId       String
  role           String // user | assistant | system
  content        String
  model          String?
  provider       String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  toolCalls      Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  AiAttachment[]
  feedback     AiFeedback[]

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

model AiAttachment {
  id             String   @id @default(uuid())
  conversationId String?
  messageId      String?
  tenantId       String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String?
  textExtract    String?
  previewUrl     String?
  createdAt      DateTime @default(now())

  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AiMessage?      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@index([tenantId])
}

model AiFeedback {
  id             String   @id @default(uuid())
  conversationId String?
  messageId      String
  tenantId       String
  userId         String
  rating         String // like | dislike
  comment        String?
  createdAt      DateTime @default(now())

  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AiMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([tenantId])
}

model AiUsage {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  conversationId String?
  provider       String
  model          String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  latencyMs      Int      @default(0)
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Website Services — customer requests + admin chat
// ─────────────────────────────────────────────────────────────────────────────

enum WebsiteProjectStatus {
  REQUESTED
  REVIEWING
  IN_DISCUSSION
  IN_PROGRESS
  DESIGN_REVIEW
  DEVELOPMENT
  READY_FOR_REVIEW
  PUBLISHED
  COMPLETED
}

enum WebsiteConversationStatus {
  OPEN
  CLOSED
}

/// A professional website request submitted by a Doloyal customer. The Doloyal
/// team (admins) review it and build the site, while the customer discusses and
/// tracks the project through the built-in chat.
model WebsiteProject {
  id             String                @id @default(cuid())
  tenantId       String
  customerUserId String
  name           String
  websiteType    String
  goal           String?
  status         WebsiteProjectStatus  @default(REQUESTED)
  liveUrl        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerUser  User                        @relation("CustomerWebsiteProjects", fields: [customerUserId], references: [id], onDelete: Cascade)
  requirements  WebsiteProjectRequirement?
  files         WebsiteProjectFile[]
  conversation  WebsiteConversation?
  statusHistory WebsiteProjectStatusHistory[]

  @@index([tenantId, status])
  @@index([customerUserId])
  @@index([status, updatedAt])
}

/// Structured answers captured by the Website Services request form.
model WebsiteProjectRequirement {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  businessName           String
  businessType           String
  businessLocation       String?
  businessPhone          String?
  businessEmail          String?
  existingWebsiteUrl     String?
  /// One or more website types (Business, Booking, Landing Page, E-commerce…)
  websiteTypes           String[] @default([])
  /// Preferred design styles (Minimal, Modern, Premium, Bold…)
  designStyle            String[] @default([])
  /// REFERENCE (customer provided a reference) | SUGGEST (Doloyal decides)
  designPreference       String
  referenceUrl           String?
  hasLogo                Boolean  @default(false)
  logoUrl                String?
  pageCount              String
  requiredFeatures       String[] @default([])
  additionalRequirements String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Files uploaded to a website project (reference images, logo, brand assets,
/// chat attachments). URLs are stored as data-URLs matching the tenant upload
/// flow so they stay fully persistent without external storage credentials.
model WebsiteProjectFile {
  id                String   @id @default(cuid())
  projectId         String
  uploadedByUserId  String
  uploadedByRole    String   @default("CUSTOMER") // CUSTOMER | ADMIN
  /// REFERENCE | LOGO | BRAND_ASSET | CHAT_ATTACHMENT
  category          String
  fileName          String
  mimeType          String?
  sizeBytes         Int?
  url               String
  createdAt         DateTime @default(now())

  project WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// One conversation per website project, linking the customer with the
/// Doloyal team. `assignedAdminId` is set when an admin picks up the request.
model WebsiteConversation {
  id                String                   @id @default(cuid())
  projectId         String                   @unique
  tenantId          String
  assignedAdminId   String?
  assignedAdminName String?
  status            WebsiteConversationStatus @default(OPEN)
  lastMessageAt     DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  project  WebsiteProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin    User?                   @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages WebsiteMessage[]
  notes    WebsiteConversationNote[]

  @@index([tenantId, status])
}

/// Chat messages exchanged between the customer and the Doloyal team.
model WebsiteMessage {
  id                 String   @id @default(cuid())
  conversationId     String
  tenantId           String
  senderId           String
  /// CUSTOMER | ADMIN | SYSTEM
  senderRole         String
  message            String
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  /// Inline-rendered confirmation that a URL was shared.
  isLink             Boolean  @default(false)
  readAt             DateTime?
  createdAt          DateTime @default(now())

  conversation WebsiteConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

/// Immutable record of every project status transition.
model WebsiteProjectStatusHistory {
  id            String   @id @default(cuid())
  projectId     String
  oldStatus     String?
  newStatus     String
  changedById   String?
  changedByName String?
  note          String?
  createdAt     DateTime @default(now())

  project   WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User?          @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

/// Private notes admins attach to a project's conversation (internal only).
model WebsiteConversationNote {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  authorName     String?
  note           String
  createdAt      DateTime @default(now())

  conversation WebsiteConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
