generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  RECEPTIONIST
  STAFF
  CUSTOMER
}

enum StaffStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  AT_RISK
  CHURNED
  INACTIVE
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  REFUNDED
  VOID
}

enum LoyaltyMode {
  POINTS_PER_SPEND
  VISIT_BASED
  TIERED
  HYBRID
  SUBSCRIPTION
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
  EXPIRED
}

enum ReferralCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
  EXPIRED
}

enum ReferralLifecycleStatus {
  PENDING
  VISITED
  SIGNED_UP
  BOOKED
  CONVERTED
  REJECTED
  REWARD_SENT
  EXPIRED
}

enum RewardStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SCHEDULED
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

enum ActivityType {
  CUSTOMER_CREATED
  APPOINTMENT_BOOKED
  INVOICE_PAID
  POINTS_EARNED
  POINTS_REDEEMED
  TIER_UPGRADED
  CAMPAIGN_SENT
  NOTE_ADDED
}

model User {
  id                String   @id @default(uuid())
  clerkId           String?  @unique
  email             String   @unique
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  password          String?  // hashed password for email/password auth
  googleId          String?  @unique // Google OAuth subject ID
  twoFactorEnabled  Boolean  @default(false)
  tokenVersion      Int      @default(0)
  sessions          Json?
  /// Whether this user is part of the Doloyal team and may access the
  /// internal Website Services admin panel.
  isAdmin           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships Membership[]
  integrations Integration[]
  websiteProjects  WebsiteProject[]            @relation("CustomerWebsiteProjects")
  adminConversations WebsiteConversation[]      @relation("AssignedAdmin")
  adminStatusChanges WebsiteProjectStatusHistory[] @relation("StatusChangedBy")

  staffProfiles     StaffProfile[]
  invitationsSent   Invitation[]       @relation("InvitedBy")
  staffActivities   StaffActivityLog[] @relation("StaffActivityActor")
  authAuditLogs     AuditLog[]         @relation("AuditActor")
  loginHistory      LoginHistory[]
  notesWritten      EmployeeNote[]     @relation("NoteAuthor")
  profileImages     ProfileImage[]
}

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  category           String
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  coverBannerUrl     String?
  faviconUrl         String?
  tagline            String?
  description        String?
  address            String?
  city               String?
  state              String?
  zip                String?
  country            String   @default("US")
  currency           String   @default("USD")
  timezone           String   @default("UTC")
  language           String   @default("en")
  dateFormat         String   @default("DD/MM/YYYY")
  timeFormat         String   @default("12h")
  businessHours      Json?
  taxRate            Float    @default(0.0)
  brandColor         String?  @default("#2563EB")
  secondaryColor     String?  @default("#64748B")
  accentColor        String?  @default("#F59E0B")
  fontFamily         String?  @default("Inter")
  gst                String?
  registrationNumber String?
  whatsapp           String?
  mapsUrl            String?
  socialLinks        Json?
  legalPolicies      Json?
  businessStatus     Json?
  notificationPrefs  Json?
  /// Whether the owner has completed the onboarding flow. Drives the
  /// "skip onboarding and go straight to dashboard" client behavior.
  onboardingComplete Boolean  @default(false)
  maxDailyBookings   Int      @default(50)
  minBookingNotice   Int      @default(60)
  maxAdvanceBookingDays Int   @default(30)
  bufferTime         Int      @default(15)
  holidays           Json?
  blockedDates       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships           Membership[]
  branches              Branch[]
  staff                 Staff[]
  staffProfiles         StaffProfile[]
  invitations           Invitation[]
  staffActivityLogs     StaffActivityLog[]
  staffAuditLogs        AuditLog[]
  staffLoginHistory     LoginHistory[]
  employeeNotes         EmployeeNote[]
  customers             Customer[]
  services              Service[]
  appointments          Appointment[]
  invoices              Invoice[]
  loyaltyConfig         LoyaltyConfig?
  pointsLedger          PointsLedger[]
  rewards               Reward[]
  redemptions           RewardRedemption[]
  rewardPrograms        RewardProgramConfig[]
  cashbackTransactions  CashbackTransaction[]
  rewardClaims          RewardEngagementClaim[]
  tiers                 MembershipTier[]
  campaigns             Campaign[]
  activities            Activity[]
  loyaltyChallenges     LoyaltyChallenge[]
  loyaltyBadges         LoyaltyBadge[]
  loyaltyAutomations    LoyaltyAutomation[]
  loyaltyReferrals      LoyaltyReferral[]
  referralCampaigns     ReferralCampaign[]
  referralLinks         ReferralLink[]
  referralVisits        ReferralVisit[]
  referralShares        ReferralShare[]
  referralConversions   ReferralConversion[]
  referralRewards       ReferralRewardRecord[]
  referralEvents        ReferralEvent[]
  referralRegistrations ReferralRegistration[]
  referralSources       ReferralSource[]
  referralLeaderboard   ReferralLeaderboard[]
  surpriseRewards       SurpriseRewardRule[]
  loyaltyConfigVersions LoyaltyConfigVersion[]
  featureFlags          FeatureFlag[]
  loyaltyFeatureEntities LoyaltyFeatureEntity[]
  loyaltyAuditLogs      LoyaltyAuditLog[]
  subscriptions         Subscription[]
  subscriptionEvents    SubscriptionEvent[]
  bookingLinks          BookingLink[]
  notifications         Notification[]
  notificationTemplates NotificationTemplate[]
  blockedDateEntries    BlockedDate[]
  calendarEvents        CalendarEvent[]
  widgetSettings        WidgetSettings?
  availabilityConfig    AvailabilityConfig?
  websites              Website[]
  websiteProjects       WebsiteProject[]
  websiteConversations  WebsiteConversation[]
  websiteMessages       WebsiteMessage[]
  integrations          Integration[]
  connectedWebsites     ConnectedWebsite[]
  websiteApiKeys        WebsiteApiKey[]
  websiteWebhooks       WebsiteWebhook[]
  connectionLogs        ConnectionLog[]
  sdkInstallations      SdkInstallation[]
  aiConversations       AiConversation[]
  aiUsage               AiUsage[]
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

// ─── Team Management ────────────────────────────────────────────────────────

/// Extended per-member profile for the Team Management module. One row per
/// (user, tenant); mirrors Membership.role for fast, denormalized queries.
model StaffProfile {
  id                   String      @id @default(uuid())
  userId               String
  tenantId             String
  role                 Role        @default(STAFF)
  status               StaffStatus @default(PENDING)
  department           String?
  jobTitle             String?
  notes                String?
  /// string[] of granted permission keys (overrides role defaults).
  permissions          Json?
  requirePasswordReset Boolean     @default(false)
  twoFactorRequired    Boolean     @default(false)
  isOnline             Boolean     @default(false)
  lastSeenAt           DateTime?
  lastLoginAt          DateTime?
  lastLogoutAt         DateTime?
  lastLoginIp          String?
  lastLoginDevice      String?
  lastLoginBrowser     String?
  lastLoginOs          String?
  lastLoginLocation    String?
  dateJoined           DateTime    @default(now())
  createdBy            String?
  updatedAt            DateTime    @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches StaffBranch[]
  employeeNotes EmployeeNote[]

  @@unique([userId, tenantId])
  @@index([tenantId, role, status])
  @@index([tenantId, isOnline])
}

/// Join table allowing a member to belong to one or many branches.
model StaffBranch {
  id             String   @id @default(uuid())
  staffProfileId String
  branchId       String
  primary        Boolean  @default(false)
  assignedAt     DateTime @default(now())

  staff  StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, branchId])
  @@index([branchId])
}

/// Member invitations with a secure token, expiry and full lifecycle tracking.
model Invitation {
  id            String           @id @default(uuid())
  tenantId      String
  email         String
  firstName     String?
  lastName      String?
  phone         String?
  role          Role             @default(STAFF)
  branchIds     String[]         @default([])
  department    String?
  jobTitle      String?
  permissions   Json?
  notes         String?
  status        InvitationStatus @default(PENDING)
  token         String           @unique
  invitationUrl String?
  expiresAt     DateTime
  sentAt        DateTime?
  acceptedAt    DateTime?
  resendCount   Int              @default(0)
  invitedById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, email])
}

/// Activity timeline for staff management actions (who did what).
model StaffActivityLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  actorName  String?
  targetId   String?
  targetName String?
  action     String
  category   String?
  message    String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("StaffActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, actorId])
  @@index([tenantId, targetId])
}

/// Immutable audit trail. Admins cannot modify these rows (no update endpoints).
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  actorName  String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

/// Every login attempt (successful and failed) per user.
model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  tenantId   String?
  successful Boolean  @default(true)
  device     String?
  browser    String?
  os         String?
  ip         String?
  location   String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

/// Private notes visible only to admins (performance, warnings, promotions).
model EmployeeNote {
  id             String   @id @default(uuid())
  tenantId       String
  staffProfileId String
  authorId       String?
  authorName     String?
  body           String
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  author User?        @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([staffProfileId])
}

/// Profile photo history for members.
model ProfileImage {
  id        String   @id @default(uuid())
  userId    String
  url       String
  provider  String   @default("internal")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  address   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff[]
  staffAssignments StaffBranch[]
}

model Staff {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String?
  name        String
  email       String?
  phone       String?
  roleTitle   String   @default("Specialist")
  avatarUrl   String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  blockedDateEntries BlockedDate[]
  bookingLinks     BookingLink[]
}

model Customer {
  id             String         @id @default(uuid())
  tenantId       String
  firstName      String
  lastName       String
  email          String?
  phone          String
  dob            DateTime?
  avatarUrl      String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?
  tags           String[]       @default([])
  pointsBalance  Int            @default(0)
  totalSpent     Float          @default(0.0)
  totalVisits    Int            @default(0)
  churnRiskScore Float          @default(0.0)
  visitStreak    Int            @default(0)
  longestStreak  Int            @default(0)
  referralCode   String?
  cashbackBalance Float         @default(0.0)
  lastVisitAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  invoices     Invoice[]
  pointsLedger PointsLedger[]
  notifications Notification[]
  redemptions  RewardRedemption[]
  memberships  CustomerMembership[]
  activities   Activity[]
  challengeProgress ChallengeParticipant[]
  badges       CustomerBadge[]
  referralsMade    LoyaltyReferral[] @relation("Referrer")
  referralReceived LoyaltyReferral?  @relation("Referred")
  referralLinks    ReferralLink[]
  referralsAsReferrer ReferralConversion[] @relation("ConversionReferrer")
  referralsAsFriend   ReferralConversion[] @relation("ConversionFriend")
  referralRewards  ReferralRewardRecord[]
  registrationsAsReferrer ReferralRegistration[] @relation("RegistrationReferrer")
  registrationsAsFriend   ReferralRegistration[] @relation("RegistrationFriend")
  referralLeaderboardRows ReferralLeaderboard[]
  cashbackTxns CashbackTransaction[]
  rewardClaims RewardEngagementClaim[]

  @@unique([tenantId, referralCode])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, dob])
}

model Service {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  description      String?
  durationMinutes  Int      @default(30)
  price            Float
  category         String   @default("General")
  pointsMultiplier Float    @default(1.0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  customerId      String
  staffId         String?
  serviceName     String
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(BOOKED)
  notes           String?
  source          String            @default("DASHBOARD")
  paymentStatus   String            @default("PENDING")
  paymentAmount   Float?
  bookingLinkId   String?
  cancelledAt     DateTime?
  rescheduledFrom String?
  serviceId       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff          Staff?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  bookingLink    BookingLink?     @relation(fields: [bookingLinkId], references: [id], onDelete: SetNull)
  notifications  Notification[]
  calendarEvents CalendarEvent[]

  @@index([bookingLinkId])
  @@index([tenantId, startTime])
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  customerId    String
  invoiceNumber String
  subtotal      Float
  discount      Float         @default(0.0)
  tax           Float         @default(0.0)
  total         Float
  status        InvoiceStatus @default(PAID)
  paymentMethod String        @default("CARD")
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model LoyaltyConfig {
  id             String      @id @default(uuid())
  tenantId       String      @unique
  mode           LoyaltyMode @default(POINTS_PER_SPEND)
  pointsPerUnit  Int         @default(1)
  currencyUnit   Float       @default(1.0)
  expiryDays     Int         @default(365)
  pointsPerVisit Int         @default(10)
  signupBonus    Int         @default(50)
  referralBonus  Int         @default(100)
  /// Extended bonuses, toggles, redemption limits, etc.
  settings       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PointsLedger {
  id           String    @id @default(uuid())
  tenantId     String
  customerId   String
  amount       Int
  balanceAfter Int
  reason       String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Reward {
  id                  String       @id @default(uuid())
  tenantId            String
  name                String
  description         String?
  pointsCost          Int          @default(0)
  discountVal         Float        @default(0.0)
  rewardValue         Float        @default(0.0)
  status              RewardStatus @default(DRAFT)
  imageUrl            String?
  /// STANDARD | BIRTHDAY | ANNIVERSARY | REVIEW | SOCIAL | WHATSAPP | CASHBACK
  category            String       @default("STANDARD")
  /// POINTS | COUPON | FREE_SERVICE | GIFT | GIFT_CARD | CASHBACK | CUSTOM | VIP
  rewardType          String       @default("CUSTOM")
  quantity            Int?         // null = unlimited
  redeemedCount       Int          @default(0)
  validityDays        Int          @default(90)
  startsAt            DateTime?
  expiresAt           DateTime?
  branchIds           String[]     @default([])
  tierRequired        String?
  membershipRequired  String?
  terms               String?
  metadata            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([tenantId, category, status])
  @@index([tenantId, status])
}

model RewardRedemption {
  id             String           @id @default(uuid())
  tenantId       String
  customerId     String
  rewardId       String
  code           String           @unique
  status         RedemptionStatus @default(PENDING)
  pointsUsed     Int              @default(0)
  cashbackAmount Float            @default(0)
  branchId       String?
  branchName     String?
  redeemedAt     DateTime?
  createdAt      DateTime         @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward   Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

/// Automated reward program settings (birthday, anniversary, review, social, whatsapp, cashback).
model RewardProgramConfig {
  id          String   @id @default(uuid())
  tenantId    String
  programType String
  enabled     Boolean  @default(false)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, programType])
  @@index([tenantId, enabled])
}

model CashbackTransaction {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  pointsUsed  Int
  cashbackAmount Float
  balanceAfter Float
  status      String   @default("COMPLETED")
  note        String?
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

model RewardEngagementClaim {
  id           String   @id @default(uuid())
  tenantId     String
  customerId   String
  programType  String   // REVIEW | SOCIAL | WHATSAPP
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  evidence     Json?
  rewardPoints Int      @default(0)
  rewardId     String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, programType, status])
  @@index([tenantId, customerId])
}

model MembershipTier {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  price              Float    @default(0.0)
  validityDays       Int      @default(365)
  discountPercent    Float    @default(0.0)
  bonusPointsPercent Float    @default(0.0)
  pointsMultiplier   Float    @default(1.0)
  minPoints          Int      @default(0)
  rank               Int      @default(0)
  priorityBooking    Boolean  @default(false)
  exclusiveRewards   String[] @default([])
  benefits           String[] @default([])
  badgeLabel         String?
  color              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships CustomerMembership[]
}

model CustomerMembership {
  id         String   @id @default(uuid())
  customerId String
  tierId     String
  assignedAt DateTime @default(now())

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier     MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([customerId, tierId])
}

model Campaign {
  id         String         @id @default(uuid())
  tenantId   String
  name       String
  subject    String
  body       String
  channel    String         @default("EMAIL")
  status     CampaignStatus @default(DRAFT)
  recipients Int            @default(0)
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

