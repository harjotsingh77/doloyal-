}

/// Per-tenant feature toggles for modular Loyalty capabilities.
model FeatureFlag {
  id         String   @id @default(uuid())
  tenantId   String
  featureKey String
  enabled    Boolean  @default(false)
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId, enabled])
}

/// Generic persisted records for modular Loyalty features (spin prizes, QR codes, holidays, etc.).
model LoyaltyFeatureEntity {
