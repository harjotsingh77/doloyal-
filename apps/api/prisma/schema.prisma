  id         String   @id @default(uuid())
  tenantId   String
  featureKey String?
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, featureKey])
}

model Subscription {
  id             String   @id @default(uuid())
  tenantId       String
  plan           String   @default("free")
  status         String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, EXPIRED, TRIALING
  stripeId       String?
  stripePriceId  String?
  stripeSubId    String?
  trialEndsAt    DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt     DateTime?
  paymentMethod  String?
  autoRenew      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Immutable billing event log powering the Billing Center history.
/// One row per subscription lifecycle event (trial start, plan change,
/// payment update, cancel, restart, payment outcome).
model SubscriptionEvent {
  id          String   @id @default(uuid())
  tenantId    String
  type        String   // TRIAL_STARTED | PLAN_CHANGED | PAYMENT_METHOD_UPDATED | SUBSCRIPTION_CANCELED | SUBSCRIPTION_RESTARTED | PAYMENT_SUCCEEDED | PAYMENT_FAILED
  plan        String?
  description String?
  amount      Float?
  currency    String?
  status      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model SyncLog {
  id             String   @id @default(uuid())
  integrationId  String
  status         String   @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  recordsProcessed Int?
  errorMessage   String?
  metadata       Json?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}

model WebhookEvent {
  id             String   @id @default(uuid())
  integrationId  String
  eventType      String
  payload        Json
  status         String   @default("PENDING") // PENDING, PROCESSED, FAILED
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}


model BookingLink {
  id                  String    @id @default(uuid())
  tenantId            String
  staffId             String?
  slug                String    @unique
  type                String    @default("PERSONAL")
  name                String?
  description         String?
  isActive            Boolean   @default(true)
  isPaused            Boolean   @default(false)
  allowCustomTime     Boolean   @default(true)
  assignmentMode      String    @default("SINGLE") // SINGLE | MULTI | AUTO | ROUND_ROBIN
  staffIds            Json?     // string[] for multi-staff
  serviceIds          Json?     // string[] — empty/null = all active services
  customerFields      Json?     // field config: { name: {enabled, required}, ... }
  rules               Json?     // booking rules (buffers, notice, max, approval, etc.)
  payment             Json?     // payment mode, deposit, methods
  loyalty             Json?     // earn/redeem/birthday/referral/coupons
  membershipAccess    Json?     // EVERYONE | MEMBERS_ONLY | tier ids | STAFF_ONLY
  authMode            Json?     // guest/login/signup/google/otp/email
  branding            Json?     // theme, logo, cover, confirmation, redirect, webhook, qr
  automations         Json?     // confirmation, reminder, follow-up, review, loyalty, invoice, notify
  pageConfig          Json?     // sections order/enabled + hero/about/faq/gallery content
  seo                 Json?     // keywords, ogImage, favicon, schema extras
  domain              Json?     // subdomain, customDomain, status PENDING|ACTIVE|FAILED
  confirmationMessage String?
  redirectUrl         String?
  webhookUrl          String?
  theme               Json?
  expiresAt           DateTime?
  visitCount          Int       @default(0)
  bookingCount        Int       @default(0)
  revenueGenerated    Float     @default(0)
  lastBookingAt       DateTime?
  roundRobinIndex     Int       @default(0)
  metaTitle           String?
  metaDescription     String?
  status              String    @default("PUBLISHED") // DRAFT | PUBLISHED
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff        Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  visits       BookingLinkVisit[]
  appointments Appointment[]

