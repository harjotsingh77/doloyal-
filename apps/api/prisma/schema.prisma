  conversion ReferralConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([conversionId])
}

model ReferralEvent {
  id           String   @id @default(uuid())
  tenantId     String
  campaignId   String?
  linkId       String?
  conversionId String?
  customerId   String?
  type         String
  metadata     Json?
  ipAddress    String?
