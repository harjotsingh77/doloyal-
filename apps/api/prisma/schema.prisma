  @@index([slug])
}

model BookingLinkVisit {
  id            String   @id @default(uuid())
  bookingLinkId String
  tenantId      String
  source        String?  // instagram, facebook, google, website, whatsapp, qr, direct
  referrer      String?
  userAgent     String?
  ipHash        String?
  sessionId     String?
  createdAt     DateTime @default(now())

