model ReferralCampaign {
  id                   String                 @id @default(uuid())
  tenantId             String
  name                 String
  description          String?
  campaignType         String                 @default("STANDARD")
  rewardType           String                 @default("POINTS") // POINTS, CASHBACK, FLAT_DISCOUNT, PERCENT_DISCOUNT, COUPON, GIFT, FREE_SERVICE, MEMBERSHIP_UPGRADE
  rewardValue          Float                  @default(100)
  friendRewardType     String                 @default("POINTS")
  friendRewardValue    Float                  @default(50)
  minPurchase          Float                  @default(0)
  minAppointmentValue  Float                  @default(0)
  maxRewardLimit       Float?
  startsAt             DateTime?
  endsAt               DateTime?
  status               ReferralCampaignStatus @default(DRAFT)
  usageLimit           Int?
  usageCount           Int                    @default(0)
  referralExpiryDays   Int                    @default(30)
  terms                String?
  clickCount           Int                    @default(0)
  shareCount           Int                    @default(0)
  visitCount           Int                    @default(0)
  conversionCount      Int                    @default(0)
  revenueTotal         Float                  @default(0)
  rewardsGiven         Int                    @default(0)
  createdBy            String?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links        ReferralLink[]
  visits       ReferralVisit[]
  conversions  ReferralConversion[]
  events       ReferralEvent[]
  registrations ReferralRegistration[]

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
}

model ReferralLink {
  id              String    @id @default(uuid())
  tenantId        String
  customerId      String?
  campaignId      String?
  name            String?
  code            String    @unique
  customSlug      String?   @unique
  secureToken     String?
  referralUrl     String?
  shortUrl        String?
  qrCode          String?
  clickCount      Int       @default(0)
  uniqueVisitors  Int       @default(0)
  shareCount      Int       @default(0)
  conversionCount Int       @default(0)
  revenue         Float     @default(0)
  status          String    @default("ACTIVE")
  expiresAt       DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  campaign      ReferralCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
